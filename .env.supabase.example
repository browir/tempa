# Contoh koneksi ke Supabase, hanya untuk menjalankan migrasi dari laptop.
# Salin menjadi .env.supabase (TIDAK ikut ke git), isi nilainya, lalu:
#   php artisan db:ensure-schema --env=supabase     (sekali, membuat schema "tempa")
#   php artisan migrate --pretend --env=supabase    (cek dulu)
#   php artisan migrate --seed --force --env=supabase

APP_ENV=production
# Samakan dengan APP_KEY di dashboard Vercel (APP_KEY Tempa sendiri, BUKAN milik Sisih).
APP_KEY=
DB_CONNECTION=pgsql
DB_SSLMODE=require
# Tempa numpang di project Supabase Sisih; semua tabel Tempa ada di schema ini, terpisah dari "public" milik Sisih.
DB_SEARCH_PATH=tempa

# Connection string "Session pooler" dari project Supabase SISIH (Connect > Session pooler, port 5432),
# ganti [YOUR-PASSWORD] dengan password database. WAJIB session pooler: search_path dipasang per koneksi,
# transaction pooler (6543) bisa memindah query ke koneksi lain yang search_path-nya "public".
DB_URL=

APP_TIMEZONE=Asia/Jakarta

# Akun login kamu di versi online
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
