# Contoh koneksi ke Supabase, hanya untuk menjalankan migrasi dari laptop.
# Salin menjadi .env.supabase (TIDAK ikut ke git), isi nilainya, lalu:
#   php artisan migrate --pretend --env=supabase   (cek dulu)
#   php artisan migrate --seed --force --env=supabase

APP_ENV=production
# Samakan dengan APP_KEY di dashboard Vercel.
APP_KEY=
DB_CONNECTION=pgsql
DB_SSLMODE=require

# Tempel "Session pooler" connection string dari Supabase (Connect > Session pooler, port 5432),
# ganti [YOUR-PASSWORD] dengan password database.
# Bila memakai transaction pooler (6543), tambahkan DB_EMULATE_PREPARES=true.
DB_URL=

APP_TIMEZONE=Asia/Jakarta

# Akun login kamu di versi online
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=
